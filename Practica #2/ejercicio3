
"""Ejercicio 3:Calcula el n-ésimo numero de Fibonacci usando recursión."""


def fibonacci(n):
    if n == 0:  
        return 0
    elif n == 1:
        return 1
    else:       
        return fibonacci(n - 1) + fibonacci(n - 2)


n = int(input("Introduce la posición n para calcular el numero de Fibonacci: "))
print(f"El numero de Fibonacci en la posición {n} es: {fibonacci(n)}")
